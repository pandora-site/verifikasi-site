# ============================================================
# .gitignore - verifikasi-site
# ============================================================

# APK (jangan commit APK ke GitHub)
*.apk
*.aab

# Logs
*.log
*.tmp

# Secrets & Config
.env
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
*secret*
*password*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak

# Backup files
*-backup.html
*-backup.js

# Hidden files
*.local
*.local.*
