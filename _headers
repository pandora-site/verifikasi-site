# ============================================================
# WEBSOCKET - /ws
# ============================================================
/ws
/ws/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, Sec-WebSocket-Key, Sec-WebSocket-Version, Sec-WebSocket-Extensions
  Access-Control-Max-Age: 86400
  Upgrade: websocket
  Connection: Upgrade
  Sec-WebSocket-Version: 13

# ============================================================
# PUSH NOTIFICATION - /push
# ============================================================
/push
/push/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, Vapid-Key
  Access-Control-Expose-Headers: Vapid-Key
  Access-Control-Max-Age: 86400
  Cache-Control: no-cache

# ============================================================
# SERVICE WORKER - /sw.js
# ============================================================
/sw.js
/sw-*.js
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# ============================================================
# ROBOTS & WELL-KNOWN
# ============================================================
/robots.txt
/favicon.ico
/.well-known/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Cache-Control: public, max-age=86400

# ============================================================
# VERSION.JSON (AUTO-UPDATE)
# ============================================================
/version.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Cache-Control: public, max-age=300
  Content-Type: application/json

# ============================================================
# ICON (NOTIFICATION)
# ============================================================
/icon.png
/*icon*.png
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Cache-Control: public, max-age=86400, immutable
  Content-Type: image/png

# ============================================================
# CATCH-ALL (FALLBACK)
# ============================================================
/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With
  Access-Control-Max-Age: 86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: no-referrer-when-downgrade
  Cache-Control: public, max-age=3600


# ============================================================
# GET-PASSWORD ENDPOINT
# ============================================================
/get-password
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Cache-Control: no-cache


# ============================================================
# ANTI-FINGERPRINT & SECURITY HEADERS
